{
	"name": "obsidian-confluence-root",
	"version": "7.0.0",
	"private": true,
	"workspaces": [
		"packages/lib",
		"packages/mermaid-electron-renderer",
		"packages/mermaid-puppeteer-renderer",
		"packages/plantuml-renderer",
		"packages/cli",
		"packages/obsidian"
	],
	"type": "module",
	"scripts": {
		"prepare": "husky install",
		"predev-obsidian": "vp run build",
		"dev-obsidian": "vp run --parallel --filter @markdown-confluence/lib --filter @markdown-confluence/mermaid-electron-renderer --filter obsidian-confluence dev",
		"build": "vp run -r build",
		"check": "vp check && node scripts/check-descriptive-names.js",
		"fmt": "vp fmt --write",
		"fmt:check": "vp fmt --check",
		"lint": "vp lint --vitest-plugin --react-plugin . && node scripts/check-descriptive-names.js",
		"lint:names": "node scripts/check-descriptive-names.js",
		"mutation": "stryker run",
		"mutation:dry-run": "stryker run --dryRunOnly",
		"test": "vp test run",
		"release:prepare": "node scripts/prepare-release-assets.js",
		"test:confluence-e2e": "node scripts/confluence-release-e2e.js",
		"test:integration": "node --env-file-if-exists=.env.integration scripts/integration-tests.js",
		"test:integration:packages": "vp run test:integration packages",
		"test:integration:live": "vp run test:integration live",
		"test:integration:docker": "vp run test:integration docker",
		"test:integration:obsidian": "vp run test:integration obsidian",
		"test:vault": "vp run test:integration vault",
		"mutation:plan": "node scripts/mutation-ci.js plan",
		"mutation:shard": "node scripts/mutation-ci.js run",
		"mutation:aggregate": "node scripts/mutation-ci.js aggregate"
	},
	"devDependencies": {
		"@effect-oxlint/effect-oxlint": "jsr:^0.2.0",
		"@effect/platform-node": "4.0.0-rc.112",
		"@effect/vitest": "4.0.0-rc.112",
		"@stryker-mutator/core": "9.6.1",
		"@stryker-mutator/typescript-checker": "9.6.1",
		"@stryker-mutator/vitest-runner": "9.6.1",
		"@types/node": "^26.5.1",
		"@vitest/runner": "4.1.11",
		"effect": "4.0.0-rc.112",
		"husky": "^9.1.7",
		"minimatch": "10.2.6",
		"mutation-testing-elements": "3.7.3",
		"mutation-testing-metrics": "3.7.3",
		"oxlint": "1.66.0",
		"tslib": "2.8.1",
		"typescript": "^6.0.3",
		"vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
		"vite-plus": "0.3.0",
		"vitest": "4.1.11"
	},
	"packageManager": "pnpm@11.1.2"
}
