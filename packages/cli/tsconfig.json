{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"baseUrl": ".",
		"rootDir": "src",
		"outDir": "dist",
		"declarationDir": "dist",
		"emitDeclarationOnly": true,
		"skipLibCheck": true
	},
	"include": ["src/**/*.ts", "src/**/*.tsx"],
	"exclude": [
		"node_modules",
		"dist",
		"dist/**/*",
		"**/*.test.ts",
		"**/jest.config.ts"
	]
}
