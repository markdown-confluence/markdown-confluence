{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"baseUrl": ".",
		"inlineSourceMap": true,
		"inlineSources": true,
		"isolatedModules": true,
		"lib": ["DOM", "ES5", "ES6", "ES7", "DOM.Iterable"],
		"module": "ESNext",
		"noImplicitAny": true,
		"skipLibCheck": true,
		"types": ["node"]
	},
	"include": ["**/*.ts", "**/*.tsx"],
	"exclude": [
		"node_modules",
		"packages/**/dist/*",
		"dist/*",
		"**/*.test.ts",
		"**/jest.config.ts"
	]
}
