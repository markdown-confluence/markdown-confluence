{
	"author": "andymac4182",
	"dependencies": {
		"@markdown-confluence/lib": "5.5.2",
		"@markdown-confluence/mermaid-electron-renderer": "5.5.2",
		"@types/lodash-es": "^4.17.12",
		"confluence.js": "^1.6.3",
		"lodash-es": "^4.17.21",
		"mime-types": "^2.1.35",
		"react": "^16.14.0",
		"react-dom": "^16.14.0"
	},
	"description": "This library allows you to publish your notes to Confluence",
	"devDependencies": {
		"@jest/globals": "^29.7.0",
		"@types/mime-types": "^2.1.1",
		"@types/node": "^16.11.6",
		"@types/react-dom": "^18.0.11",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"builtin-modules": "3.3.0",
		"esbuild": "0.17.3",
		"jest": "^29.7.0",
		"obsidian": "latest",
		"ts-jest": "^29.2.6",
		"tslib": "2.4.0",
		"typescript": "4.7.4"
	},
	"keywords": [],
	"license": "Apache 2.0",
	"main": "main.js",
	"name": "obsidian-confluence",
	"resolutions": {
		"prosemirror-model": "1.14.3"
	},
	"scripts": {
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"dev": "node esbuild.config.mjs",
		"fmt": "npx prettier --write src/",
		"lint": "eslint --ignore-path ../../.eslintignore --ext .jsx,tsx,.js,.ts src/",
		"prettier-check": "npx prettier --check src/",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test": "jest"
	},
	"type": "module",
	"version": "5.5.2"
}
