{
	"name": "obsidian-confluence",
	"version": "6.0.0",
	"description": "This library allows you to publish your notes to Confluence",
	"keywords": [],
	"license": "Apache 2.0",
	"author": "andymac4182",
	"type": "module",
	"main": "main.js",
	"scripts": {
		"dev": "vp build --watch --mode development",
		"build": "vp exec tsc --noEmit && vp build",
		"fmt": "vp fmt --write \"src/**/*.{ts,tsx,js}\"",
		"fmt:check": "vp fmt --check \"src/**/*.{ts,tsx,js}\"",
		"lint": "vp lint --react-plugin src"
	},
	"dependencies": {
		"@markdown-confluence/lib": "workspace:*",
		"@markdown-confluence/mermaid-electron-renderer": "workspace:*",
		"@markdown-confluence/plantuml-renderer": "workspace:*",
		"confluence.js": "^2.1.0",
		"mime-types": "^3.0.2",
		"react": "^19.2.7",
		"react-dom": "^19.2.7"
	},
	"devDependencies": {
		"@effect/platform-node": "4.0.0-beta.70",
		"@types/mime-types": "^3.0.1",
		"@types/react": "^19.2.15",
		"@types/react-dom": "^19.2.3",
		"csstype": "^3.2.3",
		"effect": "4.0.0-rc.112",
		"mermaid": "^11.16.1",
		"obsidian": "1.12.3"
	}
}
